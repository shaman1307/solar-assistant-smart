[Unit]
Description=Solar Smart
Documentation=file:/home/solar-assistant/project/README.md
After=local-fs.target
# Smart uses SolarAssistant on localhost — do not block on WAN (network-online)
# or influx-bridge boot; slow SA after reboot left smart disabled.
DefaultDependencies=yes
StartLimitBurst=15
StartLimitIntervalSec=600

[Service]
Type=simple
User=solar-assistant
Group=solar-assistant
WorkingDirectory=/home/solar-assistant/project
# SD card / venv can lag behind multi-user.target on Pi Zero.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 90); do test -x /home/solar-assistant/project/.venv/bin/uvicorn && exit 0; sleep 2; done; echo "uvicorn missing after boot wait" >&2; exit 1'
# Do NOT use fuser -k here: it can stall the Pi and disturb co-hosted SA/Influx.
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
# Prefer OOM-killing smart before beam.smp / SolarAssistant on memory pressure.
OOMScoreAdjust=1000
Nice=5
# Standalone on port 8000 — SolarAssistant stays on its default port 80.
# Do NOT install nginx or set PORT= in influx-bridge.env (see scripts/restore-sa-defaults.sh).
ExecStart=/home/solar-assistant/project/.venv/bin/uvicorn src.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --log-level info \
    --no-access-log
Restart=always
RestartSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart

[Install]
WantedBy=multi-user.target
