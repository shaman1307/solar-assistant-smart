##############################################################################
# Solar Smart — example configuration.
# Copy to sa-config.yaml and fill in your installation.
# Windows dev: same file + optional sa-config.local.yaml overlay (see its .example).
##############################################################################

smart_mode_enabled: false
debug_tab_enabled: false

location:
  latitude: 52.0
  longitude: 21.0

solar:
  azimuth: 180
  system_loss_factor: 0.93
  blocks:
    - power_kwp: 5.0
      tilt: 30

inverter:
  ac_capacity_kw: 5.0

battery:
  capacity_kwh: 10.0
  max_charge_power_kw: 6.0
  max_discharge_power_kw: 5.0

ev:
  max_power_kw: 11.0

simulation:
  min_soc_pct: 15
  epsilon_kwh: 0.05
  losses_pct:
    grid_to_battery: 7.5
    battery_to_load_or_grid: 7.5
    pv_to_battery: 7.5
    pv_to_grid: 7.5
    pv_to_load: 7.5

grid:
  g12:
    tariff_name: "G12"
    peak_price_pln_kwh: 1.0
    offpeak_price_pln_kwh: 0.5
    peak_energy_only_pln_kwh: 0.6
    offpeak_energy_only_pln_kwh: 0.4
  grid_export_threshold_pln_kwh: 0.5
  export_window_start_hour: 16
  super_rce_min_pln_kwh: 2.0
  distribution:
    # G12 official tariff table 2 (ROZLICZENIE DYSTRYBUCJI), netto × 1.23 brutto
    subscription_pln_month: 0.9102
    fixed_network_pln_month: 24.8091
    capacity_pln_month: 29.5815
    peak_variable_network_pln_kwh: 0.4728   # opłata sieciowa zmienna dzienna (L1)
    offpeak_variable_network_pln_kwh: 0.1017  # opłata sieciowa zmienna nocna (L2)
    quality_pln_kwh: 0.0408
    oze_pln_kwh: 0.0090
    cogeneration_pln_kwh: 0.0037

sa:
  host: "localhost"
  password: "YOUR_SA_WEB_PASSWORD"
  metrics:
    battery_soc: "battery_1/state_of_charge"
    battery_power: "battery_1/power"
    pv_power: "total/pv_power"
    load_power: "total/load_power"
    grid_power: "total/grid_power"
    pv_energy_today: "total/pv_energy"
    load_energy_today: "total/load_energy"
    grid_buy_energy: "total/grid_energy_in"
    grid_sell_energy: "total/grid_energy_out"
    battery_charged_today: "total/battery_energy_in"
    battery_discharged_today: "total/battery_energy_out"
  settings:
    charge_current_limit: "inverter_1/max_grid_charge_current"
    grid_charge_switch: "inverter_1/grid_charge"
    grid_export_switch: "inverter_1/timed_discharge"
    work_mode: "inverter_1/work_mode"
    battery_discharge_mode: "inverter_1/battery_discharge_mode"
    solar_power_priority: "inverter_1/solar_power_priority"
  work_mode_options:
    - "On-grid"
    - "Limit power to UPS load"
    - "Limit power to home load"
    - "AC coupling"
  battery_discharge_mode_options:
    - "Standby"
    - "UPS load only"
    - "UPS and home loads"
    - "Grid export enabled"
  solar_power_priority_options:
    - "Load first"
    - "Battery first"
    - "Grid first"

load:
  hourly_profile_kwh:
    - 0.30
    - 0.30
    - 0.30
    - 0.30
    - 0.30
    - 0.30
    - 0.40
    - 0.50
    - 0.60
    - 0.60
    - 0.60
    - 0.60
    - 0.60
    - 0.60
    - 0.60
    - 0.60
    - 0.70
    - 0.80
    - 0.80
    - 0.70
    - 0.60
    - 0.50
    - 0.40
    - 0.30

overrides:
  today_pv_kwh: null
  today_load_kwh: null
  tomorrow_pv_kwh: null
  tomorrow_load_kwh: null
